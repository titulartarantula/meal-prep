# → ~/.config/systemd/user/mealprep.service on the server (%h = the user's home directory)
[Unit]
Description=Meal prep server (recipes → PC Express cart)
After=network-online.target

[Service]
WorkingDirectory=%h/meal-prep/server
EnvironmentFile=%h/meal-prep/.env
Environment=PATH=%h/.local/bin:/usr/bin:/bin
Environment=HOME=%h
ExecStart=%h/meal-prep/server/.venv/bin/uvicorn --factory mealprep.api:app_from_env --host 0.0.0.0 --port 8790
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
