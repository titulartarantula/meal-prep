<?xml version="1.0" encoding="utf-8"?>
<!-- allowBackup="false" stops cloud backups, but on Android 12+ a phone-to-phone transfer still copies app data.
     The settings DataStore holds the tokens, encrypted with a Keystore key that can't move with them: keep it out of
     both (a copied file couldn't be read on the new phone anyway; the app would ask to sign in again). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
