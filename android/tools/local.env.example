# Copy to tools/local.env (gitignored) and fill in. Sourced by the shell scripts in this directory
# and by server/deploy/deploy.sh.

# Windows build host with the Android SDK + JDK 21 and OpenSSH (remote.sh, pull.sh, release.sh).
BUILD_HOST="user@build-host"                 # ssh destination
BUILD_KEY="$HOME/.ssh/id_ed25519_build"      # ssh key for BUILD_HOST
BUILD_DIR="C:/Users/you/src/meal-prep"       # working dir on the build host (forward slashes)

# Linux server that runs the mealprep API (capture_fixtures.sh, push_github.sh, server/deploy/deploy.sh).
SERVER_HOST="user@server"                    # ssh destination; the app lives in ~/meal-prep there
SERVER_KEY="$HOME/.ssh/id_ed25519_server"    # ssh key for SERVER_HOST

# GitHub repo pushed by push_github.sh (via SERVER_HOST, which has the GitHub credentials).
GITHUB_REPO="owner/meal-prep"

# Google Play upload (play_upload.sh): service account with Android Publisher access, known to gcloud.
PLAY_ACCOUNT="service-account@project.iam.gserviceaccount.com"
