{
	admin off
	auto_https off
	persist_config off
}

# Origin for mealprep.drwhom.ca: the Cloudflare tunnel (cloudflared on the host, TLS at Cloudflare) sends every
# request here. /api/* goes on to the FastAPI user service on the host's :8790 with the prefix stripped (ufw allows
# it from this compose network, 172.24.0.0/16); the rest is the web app's static files.
:8080 {
	encode zstd gzip

	# FastAPI's generated docs stay on the LAN (http://192.168.1.101:8790/docs).
	@apidocs path /api/docs /api/docs/* /api/redoc /api/openapi.json
	handle @apidocs {
		respond 404
	}
	# The server judges the shared token by the caller's address: it sees this container's, never a client's, so the
	# token is refused through the public site. Don't add X-Forwarded-For trust on the server side.
	# Cloudflare replaces any 502 or 504 from this origin with its own "origin returned an invalid response" error, so
	# the server's own sentence ("that site blocks automated readers…") never reached the page. Its 502/504 answers are
	# passed on as 424 (same body); a server that doesn't answer at all gets a JSON 503 from handle_errors below. The
	# LAN API on :8790 (the Android app) still answers 502 as before.
	handle_path /api/* {
		reverse_proxy 192.168.1.101:8790 {
			@gateway status 502 504
			handle_response @gateway {
				copy_response 424
			}
		}
	}

	# CSP etc. are set for the app's pages; JSON from /api doesn't need them but they do no harm there.
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# No inline scripts. Inline style attributes (React) need 'unsafe-inline' for styles only. Recipe and product
		# photos are links to other sites (NYT, Loblaws' CDN), so images may come from any https origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Vite names assets by content hash; index.html must always be re-checked so a deploy shows at once.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pages not path /assets/*
	header @pages Cache-Control "no-cache"

	# A single-page app: any path that isn't a file is the app's route. /privacy and /terms are static pages
	# (privacy.html, terms.html: no JavaScript, no sign-in).
	handle_errors 502 503 504 {
		@api path /api/*
		handle @api {
			header Content-Type application/json
			respond `{"detail":"The Meal Prep server isn't answering right now. Try again in a minute."}` 503
		}
	}

	handle {
		root * /srv
		try_files {path} {path}.html /index.html
		file_server
	}
}
